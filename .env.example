# Optional override for the API root.
#
# Normally you do NOT need this: public/config.json already points at the
# GarageFlow .NET API (http://localhost:5100/api) with "useMockApi": false, and
# it is read at run time so one build works against any backend.
#
# Setting this wins over config.json and also forces useMockApi off — handy for
# pointing a local UI at a staging API without editing the deployed config.
VITE_API_BASE=http://localhost:5100/api
